<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.pai_demo.mapper.CategoryMapper">
    <update id="updateCategorySelective">
        UPDATE category
        <set>
            <if test="category.name != null">
                name = #{category.name},
            </if>
            <if test="category.userId != null">
                user_id = #{category.userId},
            </if>
            <if test="category.isDelete != null">
                is_delete = #{category.isDelete},
            </if>
            <if test="category.updateTime != null">
                update_time = #{category.updateTime},
            </if>
        </set>
        WHERE id = #{category.id} and is_delete=0
    </update>
</mapper>

