<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.pai_demo.mapper.UserMapper">
    <update id="updateUserSelective">
        UPDATE `user`
        <set>
            <if test="user.password != null">
                password = #{user.password},
            </if>
            <if test="user.avatar != null">
                avatar = #{user.avatar},
            </if>
            <if test="user.nick != null">
                nick = #{user.nick},
            </if>
            <if test="user.isDelete != null">
                is_delete = #{user.isDelete},
            </if>
            <if test="user.privilege != null">
                privilege = #{user.privilege},
            </if>
            <if test="user.updateTime != null">
                update_time = #{user.updateTime},
            </if>
        </set>
        WHERE id = #{user.id}
    </update>
</mapper>

